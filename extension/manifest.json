{
  "manifest_version": 3,
  "name": "AtomicVaultReader",
  "description": "Read and browse a folder of Markdown notes. Everything stays on your machine.",
  "version": "0.4.0",
  "action": {},
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
